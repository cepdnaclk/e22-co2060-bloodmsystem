# ==============================================================
# HOPEDROP BACKEND ENVIRONMENT VARIABLES (Render / Production)
# ==============================================================

# 1. Django Core Security
DJANGO_SECRET_KEY=your-secure-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# 2. Database (Neon Serverless PostgreSQL)
# Format: postgresql://username:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# 3. Frontend & CORS
# Set this to your deployed Vercel frontend domain
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://*.onrender.com

# 4. Email (Brevo / Sendinblue SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-login-email@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-master-key
DEFAULT_FROM_EMAIL=your-verified-sender@example.com
